{
  "expo": {
    "name": "QuoteFlow",
    "slug": "quoteflow",
    "version": "1.1.0",
    "scheme": "quoteflow",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.stefan.quoteflow",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "QuoteFlow"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-local-authentication",
      "expo-font",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
