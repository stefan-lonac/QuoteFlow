{
  "expo": {
    "name": "QuoteFlow",
    "slug": "quoteflow",
    "icon": "./assets/branding/quoteflow-logo.png",
    "version": "1.1.0",
    "scheme": "quoteflow",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/quoteflow-logo.png",
        "backgroundColor": "#7819E8"
      },
      "package": "com.stefan.quoteflow",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "QuoteFlow"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-local-authentication",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/quoteflow-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#7819E8"
        }
      ],
      "expo-status-bar"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21ab7d0b-99a3-40f0-92cf-a612a2e1acb5"
      }
    }
  }
}
